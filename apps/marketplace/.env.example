# ===== 必填（Vercel 部署时在 Project Settings → Environment Variables 配置）=====

# Vercel Blob 读写 token：在 Vercel Dashboard → Storage → Create Blob Store 后自动注入
# 本地开发想连真 Blob 时，从 Vercel Project → Settings → Environment Variables 拉下来
BLOB_READ_WRITE_TOKEN=

# 存储驱动；本地默认 fs，生产为 vercelBlob
STORAGE_DRIVER=vercelBlob

# Nitro 预设；本地不要设，生产由 vercel.json 自动注入 vercel
# NITRO_PRESET=vercel

# 公开的应用 URL（用于 CORS / 回调）
NUXT_PUBLIC_APP_URL=https://marketplace.vercel.app

# ===== 选填 =====

# 用户提交 PR 到 GitHub 仓库（如启用 GitHub PR 提交流）
GITHUB_TOKEN=
