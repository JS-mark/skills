{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @aspect-mark/marketplace... build",
  "outputDirectory": ".vercel/output",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel",
      "STORAGE_DRIVER": "vercelBlob"
    }
  },
  "crons": [
    {
      "path": "/api/sources/cron",
      "schedule": "0 3 * * *"
    }
  ]
}
