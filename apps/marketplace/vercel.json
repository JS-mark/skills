{
  "framework": "nuxtjs",
  "buildCommand": "nuxt build",
  "outputDirectory": ".output",
  "installCommand": "pnpm install",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel",
      "STORAGE_DRIVER": "vercelBlob"
    }
  },
  "crons": [
    {
      "path": "/api/sources/cron",
      "schedule": "0 */6 * * *"
    }
  ]
}
